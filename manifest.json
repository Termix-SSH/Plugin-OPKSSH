{
  "id": "opkssh",
  "name": "OPKSSH",
  "version": "1.0.0",
  "description": "Connect to hosts with short-lived OpenPubkey SSH certificates after signing in with your identity provider.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-OPKSSH",
  "category": "Access & Security",
  "icon": "ShieldCheck",
  "engine": {
    "termix": ">=26.10.0",
    "api": "1"
  },
  "capabilities": [
    "db:own",
    "files:own",
    "secrets:own",
    "hosts:read",
    "process:spawn",
    "network:outbound",
    "network:serve",
    "auth:provide",
    "ui:surface"
  ],
  "contributes": {
    "auth": {
      "sshAuthTypes": ["opkssh"]
    },
    "settings": {
      "admin": [
        {
          "key": "redirectUri",
          "type": "custom",
          "component": "redirectUri"
        }
      ]
    },
    "uses": ["terminal.overlay"]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
