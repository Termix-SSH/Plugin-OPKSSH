{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [],
  "routes": {
    "GET /plugin-api/opkssh/callback": {
      "access": "public",
      "expect": {
        "anon": "any"
      },
      "note": "Public callback; refuses a request with no login in progress"
    },
    "DELETE /plugin-api/opkssh/token/:hostId": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true
    },
    "GET /plugin-api/opkssh/token/:hostId": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    }
  }
}
